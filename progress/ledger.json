  "counting_rule": "Each stable unit is independently completable. Progress counts done units only, not active/blocked work or story points. Done requires concrete merged PR, committed tests or owner-accepted evidence. Stage achievement requires every named gate done. Unit counts do not estimate equal engineering effort.",
  "states": {
    "done": "Evidence-linked and verifiably completed within its explicitly scoped contract.",
    "active": "In current execution or review; earns no completion credit.",
    "blocked": "Waiting for stated hardware, authorization, license, or human decision.",
    "planned": "Accepted scope that has not been demonstrated."
  },
  "lanes": {
    "Agent cloud": "Offline implementation, PRs, CI and docs",
    "Agent local": "Hardware- or Windows-specific execution on owner's computer",
    "Owner": "Permissions, sample rights, acceptance and release decisions"
